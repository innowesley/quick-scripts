#!/usr/bin/env bash
set -e

echo "Enter source machine IP address or Hostname:"
read -r SRC_IP

echo "Enter source machine Username (e.g., ubuntu, ec2-user, or root):"
read -r SRC_USER

if [[ -z "$SRC_IP" || -z "$SRC_USER" ]]; then
  echo "Error: IP address and Username cannot be empty"
  exit 1
fi

mkdir -p ~/.ssh
chmod 700 ~/.ssh

# Backup existing keys
if [[ -f ~/.ssh/id_ed25519 ]]; then
  mv ~/.ssh/id_ed25519 ~/.ssh/id_ed25519.bak.$(date +%s)
  mv ~/.ssh/id_ed25519.pub ~/.ssh/id_ed25519.pub.bak.$(date +%s)
fi

REMOTE="${SRC_USER}@${SRC_IP}"

scp "${REMOTE}:~/.ssh/id_ed25519" ~/.ssh/id_ed25519
scp "${REMOTE}:~/.ssh/id_ed25519.pub" ~/.ssh/id_ed25519.pub

chmod 600 ~/.ssh/id_ed25519
chmod 644 ~/.ssh/id_ed25519.pub

echo "Testing GitHub SSH authentication..."

if ssh -o BatchMode=yes -o ConnectTimeout=5 git@github.com 2>&1 | grep -q "successfully authenticated"; then
  echo "✅ GitHub SSH authentication successful"
else
  echo "⚠️ GitHub SSH test inconclusive"
  echo "Run manually: ssh -T git@github.com"
fi
