#!/usr/bin/env bash
RED="\033[0;31m"; GREEN="\033[0;32m"; YELLOW="\033[1;33m"; CYAN="\033[0;36m"; RESET="\033[0m"

echo -e "${CYAN}== Preparing system for installation ==${RESET}"

UBUNTU_VERSION="$(lsb_release -rs)"; UBUNTU_CODENAME="$(lsb_release -cs)"
echo -e "${CYAN}-- Detected Ubuntu $UBUNTU_VERSION ($UBUNTU_CODENAME)${RESET}"

if [ "$EUID" -eq 0 ]; then echo -e "${RED}Do not run as root${RESET}"; exit 1; fi

ask(){ read -rp "$(echo -e "${YELLOW}$1 [y/N]: ${RESET}")" r; [[ "$r" =~ ^[Yy]$ ]]; }
safe_apt(){ dpkg -l | grep -q " $1 " || sudo apt install -y "$1"; }

echo -e "${CYAN}-- Updating system repositories${RESET}"
sudo apt update -y || echo -e "${YELLOW}-- Repo warning, continuing${RESET}"
sudo apt upgrade -y || echo -e "${YELLOW}-- Upgrade warning, continuing${RESET}"

BASE_PACKAGES=(curl ca-certificates gnupg lsb-release git python3 python3-venv tmux wget gpg ruby-full build-essential libcurl4-openssl-dev libxslt1-dev ruby-dev)
[[ "$UBUNTU_VERSION" == 22.* ]] && BASE_PACKAGES+=(libxml2 libxml2-dev) || BASE_PACKAGES+=(libxml2-dev)
sudo apt install -y "${BASE_PACKAGES[@]}"

# Flatpak & Flathub
command -v flatpak >/dev/null || sudo apt install -y flatpak
flatpak remote-list | grep -q flathub || sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

# ----------------- Summary helper -----------------
print_row(){ local n="$1" s="$2" v="$3" src="$4"; printf "%-22s $( [ "$s" = "Missing" ] && echo "${YELLOW}%-11s${RESET}" || echo "${GREEN}%-11s${RESET}") %-22s %-10s\n" "$n" "$s" "$v" "$src"; }
installed(){ command -v "$1" >/dev/null 2>&1; }
apt_ver(){ dpkg-query -W -f='${Version}' "$1" 2>/dev/null || echo "-"; }
snap_ver(){ snap list "$1" 2>/dev/null | awk 'NR==2 {print $2}'; }
flat_ver(){ flatpak info "$1" 2>/dev/null | awk -F': ' '/Version:/ {print $2}'; }

echo -e "\n==================== INSTALL SUMMARY ===================="
printf "%-22s %-11s %-22s %-10s\n" "NAME" "STATUS" "VERSION" "SOURCE"; echo "--------------------------------------------------------"

# Apps
installed code && print_row "VS Code" "Installed" "$(snap_ver code)" "Snap" || print_row "VS Code" "Missing" "-" "-"
installed google-chrome && print_row "Google Chrome" "Installed" "$(google-chrome --version | awk '{print $3}')" "APT" || print_row "Google Chrome" "Missing" "-" "-"
if installed ptyxis; then
  PTYX_VER=$(ptyxis --version | awk '{print $2}'); print_row "Ptyxis" "Installed" "$PTYX_VER" "APT"
elif flatpak list | grep -q app.devsuite.Ptyxis; then
  print_row "Ptyxis" "Installed" "$(flat_ver app.devsuite.Ptyxis)" "Flatpak"
else
  print_row "Ptyxis" "Missing" "-" "-"
fi
installed docker && print_row "Docker" "Installed" "$(docker --version | grep -o '[0-9.]\+')" "APT" || print_row "Docker" "Missing" "-" "-"
installed psql && print_row "PostgreSQL" "Installed" "$(psql --version | awk '{print $3}')" "APT" || print_row "PostgreSQL" "Missing" "-" "-"
installed node && print_row "Node.js" "Installed" "$(node -v | sed 's/v//')" "APT" || print_row "Node.js" "Missing" "-" "-"
installed npm && print_row "npm" "Installed" "$(npm -v)" "APT" || print_row "npm" "Missing" "-" "-"
installed chromium || installed chromium-browser && print_row "Chromium" "Installed" "$(chromium --version 2>/dev/null | awk '{print $2}')" "APT/Snap" || print_row "Chromium" "Missing" "-" "-"
installed tailscale && print_row "Tailscale" "Installed" "$(tailscale version 2>/dev/null | grep -o '[0-9.]\+')" "APT" || print_row "Tailscale" "Missing" "-" "-"

# Productivity
for t in fzf rg batcat htop jq; do
  [ "$t" = "batcat" ] && t_cmd="batcat" || t_cmd="$t"
  installed $t_cmd && print_row "$t" "Installed" "$($t_cmd --version 2>/dev/null | head -n1)" "APT" || print_row "$t" "Missing" "-" "-"
done

# Networking
for t in ifconfig traceroute mtr http tcpdump; do
  installed $t && print_row "$t" "Installed" "$( $t --version 2>/dev/null | head -n1 | awk '{print $2}') " "APT" || print_row "$t" "Missing" "-" "-"
done

# PenTest
for t in nmap amass nikto sqlmap gobuster feroxbuster hydra crunch wpscan dirsearch whatweb masscan; do
  installed $t && print_row "$t" "Installed" "$(apt_ver $t)" "APT" || print_row "$t" "Missing" "-" "-"
done

# Utilities
for t in git python3 tmux; do
  installed $t && print_row "$t" "Installed" "$($t --version 2>/dev/null | head -n1 | awk '{print $2}')" "APT" || print_row "$t" "Missing" "-" "-"

done
echo "========================================================="
