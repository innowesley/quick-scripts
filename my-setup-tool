#!/usr/bin/env bash

# ==============================================================================
# UNIVERSAL UBUNTU SETUP SCRIPT (22.04, 24.04, 25.04)
# ==============================================================================

# Colors
RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
CYAN="\033[0;36m"
BLUE="\033[0;34m"
RESET="\033[0m"

echo -e "${CYAN}== Preparing system for installation ==${RESET}"

# Prevent root execution
if [ "$EUID" -eq 0 ]; then
  echo -e "${RED}Do not run this script as root.${RESET}"
  exit 1
fi

# -----------------------------
# Global State & Helpers
# -----------------------------
DOCKER_TYPE_CHOICE="None"
UBUNTU_CODENAME=$(lsb_release -cs)

ask() {
  read -rp "$(echo -e "${YELLOW}$1 [y/N]: ${RESET}")" response
  [[ "$response" =~ ^[Yy]$ ]]
}

# Helper to run commands without stopping the script on error
try_cmd() {
  if ! "$@"; then
    echo -e "${RED}!! Error executing: $* (Skipping...)${RESET}"
    return 1
  fi
}

# Helper for Summary data
installed() { command -v "$1" >/dev/null 2>&1; }
apt_version() { dpkg-query -W -f='${Version}' "$1" 2>/dev/null || echo "-"; }
snap_version() { snap list "$1" 2>/dev/null | awk 'NR==2 {print $2}' || echo "-"; }
flatpak_version() { flatpak info "$1" 2>/dev/null | awk -F': ' '/Version:/ {print $2}' || echo "-"; }

# -----------------------------
# System update
# -----------------------------
echo -e "${CYAN}-- Updating system repositories${RESET}"
sudo apt update -y || echo -e "${YELLOW}-- Warning: Apt update issues, continuing...${RESET}"
sudo apt upgrade -y || echo -e "${YELLOW}-- Warning: Apt upgrade issues, continuing...${RESET}"

# -----------------------------
# Base packages
# -----------------------------
echo -e "${CYAN}-- Installing base packages${RESET}"
try_cmd sudo apt install -y \
  curl ca-certificates gnupg lsb-release git python3 python3-venv \
  tmux wget gpg ruby-full build-essential libcurl4-openssl-dev \
  libxml2 libxml2-dev libxslt1-dev ruby-dev flatpak snapd

# -----------------------------
# Ptyxis (Flatpak)
# -----------------------------
if flatpak list | grep -q "app.devsuite.Ptyxis" 2>/dev/null; then
  echo -e "${GREEN}-- Ptyxis terminal is already installed${RESET}"
elif ask "Install Ptyxis terminal (Flatpak)?"; then
  try_cmd sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
  try_cmd sudo flatpak install -y flathub app.devsuite.Ptyxis
  
  # Set as default
  PTYXIS_WRAPPER="/usr/bin/ptyxis.wrapper"
  XTERM_SYMLINK="/usr/bin/x-terminal-emulator"
  echo "#!/bin/sh" | sudo tee "$PTYXIS_WRAPPER" > /dev/null
  echo "flatpak run app.devsuite.Ptyxis --new-window" | sudo tee -a "$PTYXIS_WRAPPER" > /dev/null
  sudo chmod +x "$PTYXIS_WRAPPER"
  if [ -L "$XTERM_SYMLINK" ]; then sudo mv "$XTERM_SYMLINK" "${XTERM_SYMLINK}.bak"; fi
  sudo ln -sf "$PTYXIS_WRAPPER" "$XTERM_SYMLINK"
fi

# -----------------------------
# Extension Manager
# -----------------------------
if ! flatpak list | grep -q "com.mattjakeman.ExtensionManager" 2>/dev/null; then
    if ask "Install Extension Manager (Flatpak)?"; then
        try_cmd sudo flatpak install -y flathub com.mattjakeman.ExtensionManager
    fi
fi

# -----------------------------
# Browsers
# -----------------------------
if ask "Install Google Chrome?"; then
  wget -qO- https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor | sudo tee /usr/share/keyrings/google-chrome.gpg >/dev/null
  echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" | sudo tee /etc/apt/sources.list.d/google-chrome.list
  sudo apt update -y && try_cmd sudo apt install -y google-chrome-stable
fi

if ask "Install Chromium (Snap)?"; then
  try_cmd sudo snap install chromium
fi

# -----------------------------
# Development & Cloud
# -----------------------------
if ask "Install Visual Studio Code (Snap)?"; then
  try_cmd sudo snap install code --classic
fi

if ask "Install Node.js 25?"; then
  curl -fsSL https://deb.nodesource.com/setup_25.x | sudo -E bash -
  try_cmd sudo apt install -y nodejs
fi

if ask "Install Tailscale VPN?"; then
  try_cmd curl -fsSL https://tailscale.com/install.sh | sh
  try_cmd sudo tailscale up
fi

if ask "Install OpenCode?"; then
  try_cmd curl -fsSL https://opencode.ai/install | bash
fi

# -----------------------------
# PostgreSQL (Enhanced for 25.04 compat)
# -----------------------------
if ask "Install PostgreSQL?"; then
  sudo install -d /usr/share/postgresql-common/pgdg
  curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | sudo gpg --dearmor -o /usr/share/postgresql-common/pgdg/pgdg.gpg
  echo "deb [arch=amd64 signed-by=/usr/share/postgresql-common/pgdg/pgdg.gpg] http://apt.postgresql.org/pub/repos/apt ${UBUNTU_CODENAME}-pgdg main" | sudo tee /etc/apt/sources.list.d/pgdg.list
  sudo apt update -y
  try_cmd sudo apt install -y postgresql-18 postgresql-client-18 || try_cmd sudo apt install -y postgresql postgresql-client
fi

# -----------------------------
# Docker
# -----------------------------
install_docker_base() {
    sudo apt-get update -y
    sudo install -m 0755 -d /etc/apt/keyrings
    sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
    sudo chmod a+r /etc/apt/keyrings/docker.asc
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $UBUNTU_CODENAME stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
    sudo apt-get update -y
}

if ask "Install Docker?"; then
  echo -e "1. Docker CLI\n2. Docker Desktop"
  read -rp "Choice: " dchoice
  install_docker_base
  if [ "$dchoice" == "2" ] && [ "$(uname -m)" == "x86_64" ]; then
    wget -O /tmp/docker-desktop.deb https://desktop.docker.com/linux/main/amd64/docker-desktop-amd64.deb
    try_cmd sudo apt install -y /tmp/docker-desktop.deb
    DOCKER_TYPE_CHOICE="Desktop"
  else
    try_cmd sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
    DOCKER_TYPE_CHOICE="CLI"
  fi
  sudo usermod -aG docker "$USER" || true
fi

# -----------------------------
# Tools (Recon / Security)
# -----------------------------
if ask "Install Security & Recon Tools?"; then
  # Core APT security tools
  try_cmd sudo apt install -y nmap dnsutils whois masscan nikto sqlmap gobuster dirb hydra crunch whatweb tcpdump httpie mtr traceroute net-tools fzf ripgrep bat htop jq
  
  # Snap security tools
  try_cmd sudo snap install amass
  try_cmd sudo snap install feroxbuster
  
  # Ruby/Gem tools
  try_cmd sudo gem install wpscan
  
  # Pipx tools
  sudo apt install -y pipx && pipx ensurepath
  try_cmd pipx install theHarvester || true

  # dirsearch
  if [ ! -d /opt/dirsearch ]; then
    sudo git clone https://github.com/maurosoria/dirsearch.git /opt/dirsearch || true
    sudo ln -sf /opt/dirsearch/dirsearch.py /usr/local/bin/dirsearch || true
    sudo chmod +x /opt/dirsearch/dirsearch.py || true
  fi
fi

# -----------------------------
# Final Summary
# -----------------------------
echo -e "\n${BLUE}==================== INSTALL SUMMARY ====================${RESET}"
printf "%-22s %-11s %-22s\n" "NAME" "STATUS" "VERSION"
echo "--------------------------------------------------------"

# Apps
[[ $(installed code) ]] && print_status="Installed" || print_status="Missing"
printf "%-22s %-11s %-22s\n" "VS Code" "$print_status" "$(snap_version code)"

[[ $(installed google-chrome) ]] && print_status="Installed" || print_status="Missing"
printf "%-22s %-11s %-22s\n" "Chrome" "$print_status" "$(google-chrome --version 2>/dev/null | awk '{print $3}' || echo "-")"

[[ $(installed docker) ]] && print_status="Installed ($DOCKER_TYPE_CHOICE)" || print_status="Missing"
printf "%-22s %-11s %-22s\n" "Docker" "$print_status" "$(docker --version 2>/dev/null | awk '{print $3}' | tr -d ',' || echo "-")"

[[ $(installed tailscale) ]] && print_status="Installed" || print_status="Missing"
printf "%-22s %-11s %-22s\n" "Tailscale" "$print_status" "$(tailscale version 2>/dev/null | head -n1 || echo "-")"

[[ $(installed node) ]] && print_status="Installed" || print_status="Missing"
printf "%-22s %-11s %-22s\n" "Node.js" "$print_status" "$(node -v 2>/dev/null || echo "-")"

[[ $(installed nmap) ]] && print_status="Installed" || print_status="Missing"
printf "%-22s %-11s %-22s\n" "Nmap" "$print_status" "$(nmap --version 2>/dev/null | grep -o 'version [0-9.]*' | awk '{print $2}' || echo "-")"

[[ $(installed wpscan) ]] && print_status="Installed" || print_status="Missing"
printf "%-22s %-11s %-22s\n" "WPScan" "$print_status" "$(wpscan --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || echo "-")"

echo "--------------------------------------------------------"
echo -e "${GREEN}Setup process finished. Please restart your shell or log out/in for group changes.${RESET}"