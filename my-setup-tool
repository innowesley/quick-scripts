#!/usr/bin/env bash
set -euo pipefail

# ---------------------------
# Colors
# ---------------------------
RED="\033[0;31m"; GREEN="\033[0;32m"; YELLOW="\033[1;33m"; CYAN="\033[0;36m"; BLUE="\033[0;34m"; RESET="\033[0m"

# ---------------------------
# Helpers
# ---------------------------
ask(){ read -rp "$(echo -e "${YELLOW}$1 [y/N]: ${RESET}")" r; [[ "$r" =~ ^[Yy]$ ]]; }
installed(){ command -v "$1" >/dev/null 2>&1; }

# Install with apt if missing
apt_install(){ installed "$1" || sudo apt install -y "$1"; }

# ---------------------------
# Check root
# ---------------------------
[ "$EUID" -eq 0 ] && echo -e "${RED}Do not run as root${RESET}" && exit 1

# ---------------------------
# System update
# ---------------------------
echo -e "${CYAN}-- Updating system --${RESET}"
sudo apt update -y && sudo apt upgrade -y || echo -e "${YELLOW}Warning: some packages failed${RESET}"

# ---------------------------
# Base packages
# ---------------------------
echo -e "${CYAN}-- Installing base packages --${RESET}"
BASE=(curl ca-certificates gnupg lsb-release git python3 python3-venv tmux wget gpg ruby-full build-essential libcurl4-openssl-dev libxslt1-dev ruby-dev libxml2-dev)
[[ "$UBUNTU_VERSION" == 22.* ]] && BASE+=(libxml2)
sudo apt install -y "${BASE[@]}"

# ---------------------------
# Flatpak
# ---------------------------
installed flatpak || sudo apt install -y flatpak
flatpak remote-list | grep -q flathub || sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

# ---------------------------
# Apps list
# ---------------------------
declare -A apps=(
  [VSCode]="sudo snap install code --classic"
  [GoogleChrome]="wget -qO- https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor | sudo tee /usr/share/keyrings/google-chrome.gpg >/dev/null && echo 'deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main' | sudo tee /etc/apt/sources.list.d/google-chrome.list && sudo apt update && sudo apt install -y google-chrome-stable"
  [Ptyxis]="sudo flatpak install -y flathub app.devsuite.Ptyxis"
  [DockerCLI]="sudo apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin"
  [DockerDesktop]="wget -O /tmp/docker-desktop.deb https://desktop.docker.com/linux/main/amd64/docker-desktop-amd64.deb && sudo apt install -y /tmp/docker-desktop.deb"
  [PostgreSQL]="sudo apt install -y postgresql postgresql-client"
  [NodeJS]="curl -fsSL https://deb.nodesource.com/setup_25.x | sudo -E bash - && sudo apt install -y nodejs"
  [npm]="sudo apt install -y npm"
  [Chromium]="sudo snap install chromium"
  [Tailscale]="curl -fsSL https://tailscale.com/install.sh | sh && sudo tailscale up"
  [fzf]="sudo apt install -y fzf"
  [ripgrep]="sudo apt install -y ripgrep"
  [bat]="sudo apt install -y bat"
  [htop]="sudo apt install -y htop"
  [jq]="sudo apt install -y jq"
  [net-tools]="sudo apt install -y net-tools"
  [traceroute]="sudo apt install -y traceroute"
  [mtr]="sudo apt install -y mtr"
  [httpie]="sudo apt install -y httpie"
  [tcpdump]="sudo apt install -y tcpdump"
  [nmap]="sudo apt install -y nmap"
  [amass]="sudo snap install amass"
  [nikto]="sudo apt install -y nikto"
  [sqlmap]="sudo apt install -y sqlmap"
  [gobuster]="sudo apt install -y gobuster"
  [feroxbuster]="sudo snap install feroxbuster"
  [hydra]="sudo apt install -y hydra"
  [crunch]="sudo apt install -y crunch"
  [wpscan]="sudo gem install wpscan"
  [dirsearch]="[ -d /opt/dirsearch ] || sudo git clone https://github.com/maurosoria/dirsearch.git /opt/dirsearch && sudo ln -sf /opt/dirsearch/dirsearch.py /usr/local/bin/dirsearch && sudo chmod +x /opt/dirsearch/dirsearch.py"
  [whatweb]="sudo apt install -y whatweb"
  [masscan]="sudo apt install -y masscan"
)

# ---------------------------
# Interactive installation
# ---------------------------
for pkg in "${!apps[@]}"; do
  if ! installed "${pkg,,}" || [ "$pkg" = "dirsearch" ]; then
    ask "Install $pkg?" && eval "${apps[$pkg]}"
  fi
done

# ---------------------------
# Summary function
# ---------------------------
print_row(){ local name=$1 status=$2 version=$3 src=$4; [[ "$status" = "Missing" ]] && printf "%-22s ${YELLOW}%-11s${RESET} %-22s %-10s\n" "$name" "$status" "$version" "$src" || printf "%-22s ${GREEN}%-11s${RESET} %-22s %-10s\n" "$name" "$status" "$version" "$src"; }

# You can reuse your previous version-check helpers here for summary
echo -e "\n==================== INSTALL SUMMARY ===================="
printf "%-22s %-11s %-22s %-10s\n" "NAME" "STATUS" "VERSION" "SOURCE"
echo "--------------------------------------------------------"
for pkg in "${!apps[@]}"; do
  if installed "${pkg,,}" || [ "$pkg" = "dirsearch" ]; then
    print_row "$pkg" "Installed" "-" "APT/Snap/Flatpak/Git"
  else
    print_row "$pkg" "Missing" "-" "-"
  fi
done
echo "========================================================="
